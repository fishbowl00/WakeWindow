<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WakeWindow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/inknaut_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.WakeWindow.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/inknaut_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.WakeWindow</item>
        <item name="android:windowBackground">@color/inknaut_navy</item>
    </style>
</resources>
